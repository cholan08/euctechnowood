# Copy this file to .env and fill it in. Never commit .env.

# Which AI image service to use: "gemini" or "mock".
# mock returns your photo unchanged, so you can work on the UI without a key.
# Leave empty to use gemini when GEMINI_API_KEY is set, otherwise mock.
IMAGE_PROVIDER=

# Get a key at https://aistudio.google.com/apikey (billing must be enabled for image models).
GEMINI_API_KEY=

# Model ids change often. Check https://ai.google.dev/gemini-api/docs/models
# Other options seen in Nov 2026: gemini-nano-banana-2.1 (cheaper), gemini-3-pro-image (higher quality, ~2x cost).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# If requests fail with 404, try v1beta.
GEMINI_API_VERSION=v1
# 1K, 2K or 4K. Bigger costs more per image.
GEMINI_IMAGE_SIZE=1K

# Max generated images per visitor IP per hour (each style = 1 image).
IMAGES_PER_HOUR=40

PORT=8787
