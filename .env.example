# Copy this file to .env and fill it in. Never commit .env.

# Which AI image service to use: "xai", "gemini" or "mock".
# Leave empty to pick automatically: xai if XAI_API_KEY is set, else gemini, else mock.
# mock returns your photo unchanged, so you can work on the UI without a key.
IMAGE_PROVIDER=

# xAI Grok Imagine (https://console.x.ai). Note: grok-4.x are chat models and cannot make images;
# the image model is grok-imagine-image-2.0.
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Google Gemini (https://aistudio.google.com/apikey, billing must be enabled for image models).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_API_VERSION=v1
GEMINI_IMAGE_SIZE=1K

# Team login for /admin. REQUIRED in production (use a long random SESSION_SECRET).
ADMIN_PASSWORD=
SESSION_SECRET=

# Limits per visitor IP per hour (each style = 1 image).
IMAGES_PER_HOUR=40
LEADS_PER_HOUR=10

# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so IP limits see the real visitor.
TRUST_PROXY=

PORT=8787
# Where the database and generated images are stored. Use a persistent disk in production.
DATA_DIR=
