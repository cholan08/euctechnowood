# Copy this file to .env and fill it in. Never commit .env.

# Which AI image service to use: "xai", "gemini" or "mock".
# Leave empty to pick automatically: xai if XAI_API_KEY is set, else gemini, else mock.
# mock returns your photo unchanged, so you can work on the UI without a key.
IMAGE_PROVIDER=

# xAI Grok Imagine (https://console.x.ai). Note: grok-4.x are chat models and cannot make images;
# the image model is grok-imagine-image-2.0.
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-2.0
# Text model for "AI help" in the prompt bars (same key; about $0.001 per click).
XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning

# Google Gemini (optional fallback; https://aistudio.google.com/apikey, billing must be enabled).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_API_VERSION=v1
GEMINI_IMAGE_SIZE=1K
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Max generated images per visitor IP per hour (a safety net on top of the per-staff daily limit).
IMAGES_PER_HOUR=40
# Images each staff member may make per day (India time), unless an admin sets their own limit.
DAILY_IMAGE_LIMIT=80
# Max "AI help" requests per visitor IP per hour.
ASSISTS_PER_HOUR=200

# Set to 1 when deployed behind Caddy / Nginx so limits see the real visitor IP.
TRUST_PROXY=

# ---- Studio management (accounts, clients, projects, stored images)
# Where the database (studio.db) and stored images live. Must be a persistent disk in production.
# Empty = ./data in the project folder.
DATA_DIR=
# A session ends after this many hours without use.
SESSION_IDLE_HOURS=12
# The first admin, created on startup only while the studio has no accounts yet.
# Or run `npm run create-admin` on the server instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Studio admin

PORT=8787
